# Copy privately and replace placeholders. Never commit .env.
# The provider endpoint/model must come from your authorized provider documentation.
AMD_API_BASE_URL=
AMD_API_KEY=
AMD_MODEL_ID=
AMD_PROVIDER_EVIDENCE=
AMD_API_STYLE=
AMD_JSON_SCHEMA=
# Local defaults apply when these are omitted; do not leave invalid placeholder values.
INFERENCE_MODE=
DATABASE_PATH=
APP_ORIGIN=
PUBLIC_DEMO=
STORAGE_MODE=
LIVE_DEMO_TOKEN=
MAX_RUNS_PER_SESSION=
MAX_TOTAL_LIVE_RUNS=
MAX_STORED_CASES=
MAX_REQUESTS_PER_MINUTE=
MAX_SESSION_REQUESTS_PER_MINUTE=
# Optional HTTPS origin for a separately verified cloud desktop build.
BATCHFENCE_BACKEND_ORIGIN=
# Private, owner-controlled pilot only. Never point the free demo at private data.
DEPLOYMENT_PROFILE=
PILOT_DATABASE_URL=
PILOT_SESSION_SECRET=
SOURCE_STORAGE_PATH=
MAX_ORG_LIVE_JOBS=
MAX_USER_LIVE_JOBS=

# Explicit owner consent to external AMD processing for private pilot records.
PILOT_AMD_DATA_APPROVED=false

# Gemma/Evolus continuation. Local backend loads D:\projects\BatchFence\.env.
# Keep the AMD_* values above: MiMo remains an independent provider path.
EVOLUS_API_BASE_URL=
EVOLUS_API_KEY=
EVOLUS_APPLICATION_ID=
# Personal key is also required for runtime configuration-drift verification.
EVOLUS_USER_API_KEY=
EVOLUS_CONTRACT_FILE=
EVOLUS_CONTRACT_SHA256=
EVOLUS_WORKFLOW_ID=
EVOLUS_EXTRACTOR_ID=
EVOLUS_AGENT_ID=
EVOLUS_GEMMA_MODEL_KEY=
EVOLUS_WORKFLOW_MANIFEST_FILE=
EVOLUS_WORKFLOW_MANIFEST_SHA256=
EVOLUS_COST_APPROVAL_FILE=
GEMMA_API_BASE_URL=
GEMMA_API_KEY=
GEMMA_MODEL_ID=
GEMMA_HOSTING_KIND=
GEMMA_JSON_OBJECT=
GEMMA_VISION_VERIFIED=false
GEMMA_COST_APPROVAL_FILE=
