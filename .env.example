# Verified in the authenticated AMD Token Factory manual/catalog on 2026-10-16.
# Recheck catalog availability before changing providers or models.
AMD_API_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
AMD_API_KEY=
AMD_MODEL_ID=MiMo-V2.6-Flash
AMD_PROVIDER_EVIDENCE=https://notebooks.amd.com/tokenfactory
AMD_API_STYLE=openai-chat
# MiMo was explicitly selected after Gemma request failures; no automatic model fallback.
# Prompt JSON plus server schema/citation validation remains enabled.
AMD_JSON_SCHEMA=false
INFERENCE_MODE=fixture
DATABASE_PATH=work/batchfence.sqlite3
APP_ORIGIN=http://127.0.0.1:8787
MAX_RUNS_PER_SESSION=12
MAX_TOTAL_LIVE_RUNS=100
# Desktop production transport is set at packaging time, HTTPS only.
BATCHFENCE_BACKEND_ORIGIN=https://your-authorized-backend.example
